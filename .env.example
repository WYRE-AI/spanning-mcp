# Single-tenant credentials (stdio, and HTTP only when AUTH_MODE=env).
# The gateway-mode compose service does not load these. Do not add them to
# that service's environment or via env_file.
SPANNING_PLATFORM=
SPANNING_ADMIN_EMAIL=
SPANNING_API_TOKEN=

# stdio (default) or http
# MCP_TRANSPORT=stdio

# Bind address for HTTP. When MCP_HTTP_HOST is unset, the server binds 127.0.0.1.
# A configured CONDUIT_S2S_SECRET honors this value. The container image sets 0.0.0.0.
# Without a secret, MCP_ALLOW_INSECURE_DEV=1 binds 127.0.0.1 only.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8080

# Required to start the HTTP transport. Leave this empty.
# Generate a value with: openssl rand -hex 32
# The process exits if this is empty or a known placeholder (so a copied
# example cannot forge X-Gateway-S2S). docker compose will not start if it
# is unset or empty. Never commit a real secret. The value is never logged.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a warning, does not check X-Gateway-S2S, and binds 127.0.0.1
# even if MCP_HTTP_HOST is a wider address such as 0.0.0.0. A known placeholder
# secret is still refused.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# X-Spanning-Platform, X-Spanning-Admin-Email, and X-Spanning-API-Token headers;
# no env fallback). The container image and Compose set gateway. Stdio ignores
# this and reads SPANNING_* from the environment.
# AUTH_MODE=env
